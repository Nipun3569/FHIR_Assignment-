{
    "name": "Data_orches",
    "objectId": "ee1369cc-8fde-4fd7-be02-9cfbf99a8272",
    {
  "properties": {
    "activities": [
      {
        "name": "ForEach_Resource",
        "type": "ForEach",
        "dependsOn": [],
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@createArray('Patient','Encounter','Observation','Condition')",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "ingest_fhir_raw",
              "type": "TridentNotebook",
              "dependsOn": [],
              "typeProperties": {
                "notebookId": "<notebook-id-ingest-fhir-raw>",
                "workspaceId": "<workspace-id>",
                "parameters": {
                  "resource_types": {
                    "value": "@json(concat('[\"', item(), '\"]'))",
                    "type": "Expression"
                  },
                  "days_back": {
                    "value": "@pipeline().parameters.days_back",
                    "type": "Expression"
                  }
                }
              }
            },
            {
              "name": "Bronze_Load",
              "type": "TridentNotebook",
              "dependsOn": [
                {
                  "activity": "ingest_fhir_raw",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "notebookId": "<notebook-id-bronze-load>",
                "workspaceId": "<workspace-id>",
                "parameters": {
                  "resource_type": {
                    "value": "@item()",
                    "type": "Expression"
                  }
                }
              }
            },
            {
              "name": "Silver_Load",
              "type": "TridentNotebook",
              "dependsOn": [
                {
                  "activity": "Bronze_Load",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "notebookId": "<notebook-id-silver-load>",
                "workspaceId": "<workspace-id>",
                "parameters": {
                  "resource_type": {
                    "value": "@item()",
                    "type": "Expression"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "Gold_Load",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "ForEach_Resource",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "notebookId": "<notebook-id-gold-load>",
          "workspaceId": "<workspace-id>"
        }
      },
      {
        "name": "log_pipeline_run",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Gold_Load",
            "dependencyConditions": [
              "Succeeded",
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "notebookId": "<notebook-id-log-pipeline-run>",
          "workspaceId": "<workspace-id>",
          "parameters": {
            "pipeline_run_id": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      }
    ],
    "parameters": {
      "days_back": {
        "type": "Int",
        "defaultValue": 3
      }
    }
  }
}

