from pyspark.sql.functions import explode, col, input_file_name, current_timestamp


resource_type   = ["Patient","Encounter","Observation","Condition"]          # Patient | Encounter | Observation | Condition
extract_date    = "2026-08-12"       # the Raw-layer date folder to read
raw_root_path   = "Files/raw"        # relative to the attached Lakehouse
bronze_table    = f"bronze_{resource_type.lower()}"

# --------------------------------------------------------------
# Core logic — wrapped as a function so:
#   (a) the pipeline can call this notebook once per resource_type
#       via the Parameters cell above, and
#   (b) you can still loop over multiple resources manually below
#       for local testing, without changing the pipeline's design.
# --------------------------------------------------------------
from pyspark.sql.functions import lit

def run_bronze_load(resource_type: str, extract_date: str) -> dict:
    bronze_table = f"bronze_{resource_type.lower()}"
    raw_path = f"{raw_root_path}/{resource_type}/{extract_date}/*.json"

    raw_df = spark.read.option("multiLine", True).json(raw_path)
    raw_df = raw_df.withColumn("raw_file_path", input_file_name())
    print(f"[{resource_type}] read {raw_df.count()} raw page file(s) from {raw_path}")

    exploded_df = (
        raw_df
        .withColumn("entry", explode(col("raw_response.entry")))
        .select(
            col("entry.resource").alias("resource"),
            col("entry.resource.id").alias("resource_id"),
            col("entry.resource.meta.versionId").alias("version_id"),
            col("entry.resource.meta.lastUpdated").alias("fhir_last_updated"),
            lit(resource_type).alias("resource_type"),
            col("api_url_or_params"),
            col("extraction_timestamp"),
            col("raw_file_path"),
        )
    )

    bronze_df = exploded_df.withColumn("bronze_load_timestamp", current_timestamp())
    row_count = bronze_df.count()
    print(f"[{resource_type}] exploded to {row_count} resource row(s)")

    (
        bronze_df.write
        .format("delta")
        .mode("append")
        .saveAsTable(bronze_table)
    )
    print(f"[{resource_type}] appended to Delta table '{bronze_table}'")

    return {"resource_type": resource_type, "bronze_table": bronze_table, "rows_written": row_count}



#result = run_bronze_load(resource_type, extract_date)


for rt in ["Patient", "Encounter", "Observation", "Condition"]:
    run_bronze_load(rt, extract_date)

